// =============================================================================
// Project:       EHand Hardware-in-the-Loop Emulation Platform
// Constraints:   Physical Pin Assignment for MSOC 30PIN FPC GPIOs (Bank 2/3)
// Target Device: GW5AT-LV138PG484AC1/I0 (GW5AT-138B)
// Specification: docs/wiring-plan.md (Issue #7)
// =============================================================================

// Clock, Reset, and Diagnostics
IO_LOC "sys_clk_p" V18;
IO_PORT "sys_clk_p" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "pcie_rstn" L13;
IO_PORT "pcie_rstn" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "led[0]" N13;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[1]" P14;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[2]" N17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[3]" N14;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 20-channel GPIO on MSOC 30PIN FPC (Bank 2/3, LVCMOS 3.3V)
// Pin 9: 2_IO8 (Target Board UART_TX -> EHand UART1_RX)
IO_LOC "fpc_gpio[0]" B22;
IO_PORT "fpc_gpio[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 10: 1_IO8 (EHand UART1_TX -> Target Board UART_RX)
IO_LOC "fpc_gpio[1]" B21;
IO_PORT "fpc_gpio[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 11: 2_IO7 (RS485 DI)
IO_LOC "fpc_gpio[2]" A21;
IO_PORT "fpc_gpio[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 12: 1_IO7 (RS485 RO)
IO_LOC "fpc_gpio[3]" B20;
IO_PORT "fpc_gpio[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 13: 2_IO6 (RS485 RE_N)
IO_LOC "fpc_gpio[4]" A20;
IO_PORT "fpc_gpio[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 14: 1_IO6 (RS485 DE)
IO_LOC "fpc_gpio[5]" A19;
IO_PORT "fpc_gpio[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 15: 2_IO5 (NTC PWM/Analog)
IO_LOC "fpc_gpio[6]" B18;
IO_PORT "fpc_gpio[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 16: 1_IO5 (Pulse 1 Out)
IO_LOC "fpc_gpio[7]" A18;
IO_PORT "fpc_gpio[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 17: 2_IO4 (Pulse 2 Out)
IO_LOC "fpc_gpio[8]" B17;
IO_PORT "fpc_gpio[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 18: 1_IO4 (Switch 1 Out)
IO_LOC "fpc_gpio[9]" A16;
IO_PORT "fpc_gpio[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 19: 2_IO3 (Switch 2 Out)
IO_LOC "fpc_gpio[10]" B16;
IO_PORT "fpc_gpio[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 20: 1_IO3 (GPIO 1 In / Observation)
IO_LOC "fpc_gpio[11]" A15;
IO_PORT "fpc_gpio[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 21: 2_IO2 (GPIO 2 In / Observation)
IO_LOC "fpc_gpio[12]" B15;
IO_PORT "fpc_gpio[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 22: 1_IO2 (GPIO 3 In / Observation)
IO_LOC "fpc_gpio[13]" A14;
IO_PORT "fpc_gpio[13]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 23: 2_IO1 (GPIO 4 In / Observation)
IO_LOC "fpc_gpio[14]" B13;
IO_PORT "fpc_gpio[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 24: 1_IO1 (Spare)
IO_LOC "fpc_gpio[15]" A13;
IO_PORT "fpc_gpio[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 5: DeBug_4
IO_LOC "fpc_gpio[16]" E21;
IO_PORT "fpc_gpio[16]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 6: DeBug_2
IO_LOC "fpc_gpio[17]" G21;
IO_PORT "fpc_gpio[17]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 7: DeBug_3
IO_LOC "fpc_gpio[18]" D21;
IO_PORT "fpc_gpio[18]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Pin 8: DeBug_1
IO_LOC "fpc_gpio[19]" G22;
IO_PORT "fpc_gpio[19]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Dedicated PLL location
GROUP "u_pll" = {"u_pll/PLL_inst"} exclusive;
GRP_LOC "u_pll" PLL_L[0] exclusive;
