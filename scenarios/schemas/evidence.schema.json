{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentprobe.dev/schemas/evidence.schema.json",
  "title": "AgentProbe Evidence Envelope",
  "description": "v0.2.0 — device identity lives only in source_device/target_device. Redundant top-level identity fields from v0.1.0 removed.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "trace_id",
    "connection_topology_id",
    "source_device",
    "target_device",
    "build_result",
    "flash_result",
    "capture_result",
    "diagnosis_result",
    "regression_result",
    "verdict",
    "confidence"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "connection_topology_id": { "type": "string", "minLength": 1 },
    "source_device": { "$ref": "#/$defs/device_identity" },
    "target_device": { "$ref": "#/$defs/device_identity" },
    "build_result": { "type": "object" },
    "flash_result": { "type": "object" },
    "capture_result": { "type": "object" },
    "diagnosis_result": { "type": "object" },
    "regression_result": { "type": "object" },
    "verdict": { "type": "string" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "escalation_reason": { "type": ["string", "null"] },
    "bottleneck": {
      "type": ["string", "null"],
      "enum": [
        "observation_gap",
        "execution_gap",
        "semantic_translation_gap",
        "agent_reasoning_gap",
        "support_boundary_gap",
        null
      ]
    },
    "mock_fidelity": {
      "type": ["object", "null"],
      "description": "Required when any result was produced via the Mock Engine (architecture P8 / §7.5).",
      "required": ["level", "model_id", "model_version"],
      "properties": {
        "level": { "type": "string", "enum": ["L1", "L2", "L3", "L4"] },
        "model_id": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "device_identity": {
      "type": "object",
      "required": ["role", "device_id", "serial", "firmware_version", "bitstream_version"],
      "properties": {
        "role": { "type": "string", "enum": ["golden", "dut", "external_target", "host"] },
        "device_id": { "type": "string", "minLength": 1 },
        "serial": { "type": "string", "minLength": 1 },
        "firmware_version": { "type": "string", "minLength": 1 },
        "bitstream_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
