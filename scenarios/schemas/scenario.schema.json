{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentprobe.dev/schemas/scenario.schema.json",
  "title": "AgentProbe Scenario",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "name",
    "support_boundary",
    "topology",
    "expected_terminal_state"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "support_boundary": {
      "type": "object",
      "required": ["phase", "target", "protocols", "capture_channels"],
      "properties": {
        "phase": { "type": "string", "enum": ["phase_1", "phase_1_5", "phase_2"] },
        "target": { "type": "string", "enum": ["dut_agentprobe", "stm32_m3", "stm32_m4", "stm32_m33"] },
        "protocols": {
          "type": "array",
          "items": { "type": "string", "enum": ["swd", "spi", "uart", "i2c"] }
        },
        "capture_channels": { "type": "integer", "minimum": 1, "maximum": 8 }
      },
      "additionalProperties": false
    },
    "topology": { "$ref": "topology.schema.json" },
    "expected_terminal_state": {
      "type": "string",
      "enum": ["regression_pass", "explicit_escalation", "unsupported", "unknown", "approval_pending"]
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
